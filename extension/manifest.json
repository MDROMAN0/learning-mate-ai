{
  "manifest_version": 3,
  "name": "Learning Mate AI",
  "version": "1.1",
  "description": "Ask topic questions about the YouTube video you are watching (spoiler-free, timestamped).",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*",
    "https://*.onrender.com/*",
    "https://*.trycloudflare.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Topic RAG"
  }
}