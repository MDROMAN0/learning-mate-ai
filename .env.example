# ---- LLM (any OpenAI-compatible API; Gemini is just the free-tier default) ----
# Gemini model names change often: check https://ai.google.dev/gemini-api/docs/deprecations (2.5 models are limited to old users; new projects: 3.8 Flash / 3.5 Flash-Lite)
# Groq has no embeddings API -> then set EMB_PROVIDER=local (requirements-local.txt) or EMB_API_KEY/EMB_BASE_URL/EMB_API_MODEL for another provider
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
# ---- embeddings: api (light, works on free host) | local (needs requirements-local.txt) ----
EMB_PROVIDER=api
# EMB_API_MODEL=gemini-embedding-001   (OpenAI: text-embedding-3-small)   EMB_MODEL=intfloat/multilingual-e5-small (local)
# ---- rerank: llm | cross-encoder | none ; chunk signal: lexical | embedding ----
RERANK_PROVIDER=llm
CHUNK_SIGNAL=lexical
# ---- ASR: local (faster-whisper) | sarvam (Bangla-first API) ----
ASR_PROVIDER=local
WHISPER_MODEL=small
ASR_LANG=
# SARVAM_API_KEY=   SARVAM_MODEL=saaras:v3   (bn-IN default; ASR_LANG=unknown for auto-detect)
# ---- misc ----
ENRICH=0
YT_LIVE=1
# YT_DOWNLOAD=0          (default: no download — captions straight from YouTube + embedded player. 1 = also download mp4 for clip files)
# YT_COOKIES_FROM_BROWSER=chrome   (last resort if yt-dlp says 'Sign in to confirm you're not a bot'; uses your logged-in browser cookies — risky for that account)
# YT_API_KEY=           (optional: YouTube Data API for Alternatives->discover)
# APP_PASSWORD=         (set on the public host so strangers can't burn your LLM quota)
DATA_DIR=data
LIBRARY_DIR=library
# ---- accounts (ChatGPT-style sign up / log in) ----
# AUTH=1                 (1 = every user must log in; APP_PASSWORD then works as an admin key for the extension)
# DAILY_LIMIT=60         (LLM-heavy requests per user per day)
# SECRET_KEY=            (signs sessions; auto-generated into data/secret.key if empty)
# DATABASE_URL=          (optional Postgres, e.g. free Neon, so accounts survive free-host restarts; else SQLite in DATA_DIR)
# LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-flash-lite-latest
